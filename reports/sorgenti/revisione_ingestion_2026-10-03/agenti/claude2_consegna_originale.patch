+"""Record the interpreter and the packages the ingestion package needs, on any runtime (laptop, Colab, Kaggle).
+
+Prints one JSON object and, with --out, writes it to a NEW file. Nothing is installed and no data is read: a missing
+package is recorded as null, so the preflight of a job can refuse instead of installing into the base runtime
+(docs/ERRORI.md, "Prima del prossimo job", point 5).
+
+    python env_check.py [--out <new file>.json]
+"""
+from __future__ import annotations
+
+import argparse
+import importlib
+import json
+import os
+import platform
+import shutil
+import subprocess
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+PACKAGES = ("numpy", "pandas", "scipy", "h5py", "anndata", "pyarrow")
+TOOLS = ("Rscript", "kaggle", "git")
+
+
+def version(name: str):
+    try:
+        return getattr(importlib.import_module(name), "__version__", "present")
+    except Exception as err:  # noqa: BLE001 - an inventory records what it cannot import
+        return None if isinstance(err, ImportError) else f"import failed: {type(err).__name__}: {err}"
+
+
+def tool(name: str):
+    path = shutil.which(name)
+    if not path:
+        return None
+    try:
+        out = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=60)
+        first = (out.stdout or out.stderr).strip().splitlines()
+        return {"path": path, "version": first[0] if first else ""}
+    except Exception as err:  # noqa: BLE001
+        return {"path": path, "version": f"not read: {type(err).__name__}"}
+
+
+def memory_bytes():
+    try:
+        with open("/proc/meminfo", encoding="utf-8") as fh:
+            kv = {l.split(":")[0]: int(l.split()[1]) * 1024 for l in fh if ":" in l}
+        return {"total": kv.get("MemTotal"), "available": kv.get("MemAvailable")}
+    except OSError:
+        return None
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--out", type=Path)
+    p.add_argument("--disk", action="append", default=[], help="a path whose free bytes are recorded (repeatable)")
+    a = p.parse_args()
+    if a.out and a.out.exists():
+        sys.exit(f"refusing: {a.out} exists")
+    info = {"utc": datetime.now(timezone.utc).isoformat(), "python": sys.version, "executable": sys.executable,
+            "platform": platform.platform(), "cpus": os.cpu_count(), "memory_bytes": memory_bytes(),
+            "packages": {n: version(n) for n in PACKAGES}, "tools": {n: tool(n) for n in TOOLS},
+            "disk_free_bytes": {d: shutil.disk_usage(d).free for d in a.disk if Path(d).exists()}}
+    text = json.dumps(info, indent=1)
+    if a.out:
+        a.out.parent.mkdir(parents=True, exist_ok=True)
+        a.out.write_text(text, encoding="utf-8")
+    print(text)
+
+
+if __name__ == "__main__":
+    main()
